<UserControl x:Class="Hertzo.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Hertzo.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:PageHeader Number="04" Kicker="SEÇÃO 04 — JOGOS" Title="PERFIS POR JOGO"
                           Subtitle="Detecta jogos da Steam, Epic, Riot e Battle.net. Cada ajuste vale só para aquele executável e nunca toca nos arquivos do jogo.">
                <StackPanel Orientation="Horizontal">
                    <Button Content="PROCURAR DE NOVO" Style="{StaticResource Btn}" Command="{Binding ScanCommand}" Margin="0,0,12,0"/>
                    <Button Content="ADICIONAR JOGO" Style="{StaticResource BtnPrimary}" Command="{Binding AddCommand}"/>
                </StackPanel>
            </ui:PageHeader>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <ui:Plate Reveal="Scan" Visibility="{Binding Scanning, Converter={StaticResource BoolVis}}" Margin="0,0,0,14">
                        <TextBlock Text="VARRENDO TODOS OS DISCOS EM BUSCA DE JOGOS…" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}"/>
                    </ui:Plate>
                    <ui:Plate Reveal="Focus" Visibility="{Binding Empty, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="NENHUM JOGO CONHECIDO ENCONTRADO" Style="{StaticResource H2}"/>
                            <TextBlock Text="Use “Adicionar jogo” e escolha o .exe principal (ex.: VALORANT-Win64-Shipping.exe, cs2.exe, FortniteClient-Win64-Shipping.exe)."
                                       Style="{StaticResource Body}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ui:Plate>

                    <ItemsControl ItemsSource="{Binding Games}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Plate Reveal="Wipe" Stagger="True" Padding="0" Margin="0,0,0,16" Code="{Binding Source, Converter={StaticResource Upper}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- lombada do cartucho -->
                                        <Border Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Border Height="10" VerticalAlignment="Top" Background="{StaticResource HatchAccentBrush}"/>
                                                <TextBlock Text="{Binding Short}" Style="{StaticResource Numeral}" FontSize="44" Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="26,22,24,22">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,14,0,0">
                                                    <ToggleButton IsChecked="{Binding Expanded, Mode=TwoWay}" Cursor="Hand" Margin="0,0,10,0" FocusVisualStyle="{x:Null}">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="Bd" BorderThickness="1" BorderBrush="{StaticResource LineStrongBrush}" Padding="12,7" Background="Transparent">
                                                                    <TextBlock x:Name="T" Text="DICAS" FontFamily="{StaticResource FontUi}" FontStretch="SemiCondensed" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource TextBrush}"/>
                                                                        <Setter TargetName="T" Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
                                                                        <Setter TargetName="T" Property="Text" Value="FECHAR DICAS"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <Button Content="PASTA" Style="{StaticResource BtnGhost}" Margin="0,0,10,0"
                                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Button Content="REVERTER" Style="{StaticResource BtnGhost}" ToolTip="Desfaz os ajustes deste jogo"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" Style="{StaticResource H1}" FontSize="36" LineHeight="38"/>
                                                    <TextBlock Text="{Binding ExePath}" Style="{StaticResource Label}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}"/>
                                                </StackPanel>
                                            </DockPanel>

                                            <!-- três ajustes lado a lado, separados por fios -->
                                            <ItemsControl ItemsSource="{Binding Tweaks}" Margin="0,20,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,0" Padding="0,14,18,4" Margin="0,0,18,0" ToolTip="{Binding Warning}">
                                                            <DockPanel>
                                                                <ToggleButton DockPanel.Dock="Bottom" Style="{StaticResource Switch}" HorizontalAlignment="Left" Margin="0,4,0,8"
                                                                              IsChecked="{Binding IsApplied, Mode=OneWay}"
                                                                              IsEnabled="{Binding IsBusy, Converter={x:Static ui:InverseBool.Instance}}"
                                                                              Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                              CommandParameter="{Binding}"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="14"/>
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12" LineHeight="17" Margin="0,5,0,8"/>
                                                                    <ui:Pill Text="{Binding EvidenceLabel}" Tone="{Binding EvidenceTone}" HorizontalAlignment="Left"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- dicas -->
                                            <Border Margin="0,16,0,0" Background="{StaticResource Bg2Brush}" Padding="20,16"
                                                    Visibility="{Binding Expanded, Converter={StaticResource BoolVis}}">
                                                <StackPanel>
                                                    <TextBlock Text="CONFIGURAÇÕES DENTRO DO JOGO" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                                                    <ItemsControl ItemsSource="{Binding Tips}" AlternationCount="100">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,5">
                                                                    <TextBlock DockPanel.Dock="Left" Width="34" Style="{StaticResource Numeral}" FontSize="18" Foreground="{StaticResource AccentBrush}"
                                                                               Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Index}}"/>
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource Body}" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </ui:Plate>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Painel da GPU -->
                <ui:Plate Grid.Column="2" Reveal="Focus" Delay="300" VerticalAlignment="Top" Code="J-GPU" Padding="0">
                    <StackPanel>
                        <Border Background="{StaticResource TextBrush}" Padding="22,14">
                            <TextBlock Text="PAINEL DA PLACA DE VÍDEO" Style="{StaticResource Numeral}" FontSize="22" Foreground="{StaticResource AccentInkBrush}" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Margin="22,16,22,20">
                            <TextBlock Text="Ficam no app do fabricante e não são alteradas pelo Hertzo." Style="{StaticResource Body}" FontSize="12.5" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding GpuTips}" AlternationCount="100">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="30" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"
                                                           Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Index}}"/>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextBrush}"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ui:Plate>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
