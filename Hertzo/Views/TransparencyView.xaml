<UserControl x:Class="Hertzo.Views.TransparencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Hertzo.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:PageHeader Number="10" Kicker="SEÇÃO 10 — TRANSPARÊNCIA" Title="O QUE NÃO FAZEMOS"
                           Subtitle="Um bom otimizador também é definido pelo que ele se recusa a fazer — e por não vender mito como ajuste."/>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Manifesto -->
                <ui:Plate Reveal="Wipe" Code="T-01 / MANIFESTO" Padding="0">
                    <StackPanel>
                        <Border Background="{StaticResource TextBrush}" Padding="26,16">
                            <TextBlock Text="NUNCA FAZEMOS" Style="{StaticResource Numeral}" FontSize="34" Foreground="{StaticResource AccentInkBrush}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Never}" AlternationCount="100" Margin="26,6,26,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Width="52" Style="{StaticResource Numeral}" FontSize="30" Foreground="{StaticResource AccentBrush}" Margin="0,-4,0,0"
                                                       Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Index}}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Plate>

                <!-- Mitos: riscados e carimbados -->
                <ui:Plate Grid.Column="2" Reveal="Glitch" Delay="200" Code="T-02 / MITOS" Padding="0">
                    <StackPanel>
                        <Border Background="{StaticResource HatchBadBrush}" Padding="26,16">
                            <TextBlock Text="MITOS POPULARES" Style="{StaticResource Numeral}" FontSize="34" Foreground="{StaticResource TextBrush}"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Myths}" Margin="26,6,26,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" Foreground="{StaticResource TextDimBrush}" TextDecorations="Strikethrough"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Foreground="{StaticResource TextBrush}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                            <!-- carimbo -->
                                            <Border Grid.Column="1" BorderBrush="{StaticResource BadBrush}" BorderThickness="2" Padding="8,2,8,0" Margin="16,0,4,0"
                                                    VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Opacity="0.9">
                                                <Border.RenderTransform><RotateTransform Angle="-9"/></Border.RenderTransform>
                                                <TextBlock Text="MITO" Style="{StaticResource Numeral}" FontSize="18" Foreground="{StaticResource BadBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Plate>
            </Grid>

            <ui:Plate Grid.Row="2" Reveal="Focus" Delay="350" Code="T-03 / LEGENDA">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="COMO LER OS SELOS" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                        <DockPanel Margin="0,0,0,10">
                            <ui:Pill DockPanel.Dock="Left" Text="EVIDÊNCIA FORTE" Tone="Ok" Width="150" Margin="0,0,14,0"/>
                            <TextBlock Text="documentado pela Microsoft/fabricante ou medido em testes controlados" Style="{StaticResource Body}" FontSize="12.5"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <ui:Pill DockPanel.Dock="Left" Text="EVIDÊNCIA MODERADA" Tone="Info" Width="150" Margin="0,0,14,0"/>
                            <TextBlock Text="mecanismo conhecido, ganho depende do PC" Style="{StaticResource Body}" FontSize="12.5"/>
                        </DockPanel>
                        <DockPanel>
                            <ui:Pill DockPanel.Dock="Left" Text="EVIDÊNCIA FRACA" Tone="Neutral" Width="150" Margin="0,0,14,0"/>
                            <TextBlock Text="popular, mas sem teste controlado — nunca entra no “Otimizar agora”" Style="{StaticResource Body}" FontSize="12.5"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="FONTES" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Title}" Style="{StaticResource BtnLink}" HorizontalAlignment="Left" Margin="0,0,0,10"
                                            ToolTip="{Binding Url}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Url}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ui:Plate>
        </Grid>
    </ScrollViewer>
</UserControl>
