<UserControl x:Class="Hertzo.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Hertzo.Ui">
    <UserControl.Resources>
        <DataTemplate x:Key="TweakRow">
            <ui:Plate Style="{StaticResource Row}" Delay="120" Flash="{Binding IsApplied}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" FontSize="16.5" Margin="0,0,12,6"/>
                            <Border Background="{StaticResource AccentBrush}" Padding="6,2" Margin="0,1,0,6" VerticalAlignment="Top"
                                    Visibility="{Binding Recommended, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="RECOMENDADO" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentInkBrush}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <ui:Pill Text="{Binding ImpactLabel}" Tone="{Binding ImpactTone}"/>
                            <ui:Pill Text="{Binding RiskLabel}" Tone="{Binding RiskTone}"/>
                            <ui:Pill Text="{Binding EvidenceLabel}" Tone="{Binding EvidenceTone}"/>
                            <ui:Pill Text="REQUER REINÍCIO" Tone="Neutral" Visibility="{Binding RequiresReboot, Converter={StaticResource BoolVis}}"/>
                        </WrapPanel>
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}">
                            <Border DockPanel.Dock="Left" Width="22" Background="{StaticResource HatchBadBrush}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding Warning}" Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Foreground="{StaticResource WarnBrush}" Margin="0,2"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsApplied, Mode=OneWay}"
                                      IsEnabled="{Binding IsBusy, Converter={x:Static ui:InverseBool.Instance}}"
                                      Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                        <TextBlock Text="APLICANDO" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Grid>
            </ui:Plate>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:PageHeader Number="03" Kicker="SEÇÃO 03 — OTIMIZAÇÕES" Title="AJUSTES DO WINDOWS"
                           Subtitle="Cada ajuste mostra impacto, risco e o nível de evidência por trás dele. Tudo tem backup e volta com um clique.">
                <Button Content="APLICAR RECOMENDADOS" Style="{StaticResource BtnPrimary}" Command="{Binding OptimizeCommand}"/>
            </ui:PageHeader>

            <ui:Plate Grid.Row="1" Reveal="Focus" Padding="22,14" Margin="0,0,0,34" Code="O-00">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,40,0">
                        <TextBlock Text="AJUSTES AVANÇADOS" Style="{StaticResource Label}" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShowAdvanced, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding Counts, Converter={StaticResource Upper}}" Style="{StaticResource Label}" FontSize="11.5" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </ui:Plate>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,40">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAdvanced}" Value="True"/>
                                                <Condition Binding="{Binding DataContext.ShowAdvanced, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- coluna editorial da categoria -->
                            <StackPanel Margin="0,0,30,0">
                                <ui:OutlineText Text="{Binding Number}" Size="96" Stroke="{StaticResource AccentBrush}" HorizontalAlignment="Left"/>
                                <Rectangle Height="2" Width="40" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" Margin="0,14,0,12"/>
                                <TextBlock Text="{Binding Name, Converter={StaticResource Upper}}" Style="{StaticResource H2}" FontSize="28" TextWrapping="Wrap" LineHeight="28" LineStackingStrategy="BlockLineHeight"/>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" Margin="0,10,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Border Background="{StaticResource BadSoftBrush}" Margin="0,0,0,12"
                                        Visibility="{Binding IsAdvanced, Converter={StaticResource BoolVis}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="44" Background="{StaticResource HatchBadBrush}"/>
                                        <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource BadBrush}" Margin="16,12"
                                                   Text="Estes ajustes trocam segurança, consumo ou estabilidade por desempenho. Nenhum entra no “Otimizar agora”. Leia o aviso de cada um antes de ligar."/>
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TweakRow}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
