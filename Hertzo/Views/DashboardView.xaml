<UserControl x:Class="Hertzo.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Hertzo.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:PageHeader Number="01" Kicker="SEÇÃO 01 — PAINEL" Title="SINAIS VITAIS"
                           Subtitle="Os pilares do Hertzo num só lugar — otimizar, medir, capturar, manter e proteger — com o hardware ao vivo logo abaixo."/>

            <!-- ================= PILARES: as propostas do Hertzo, com o dado vivo de cada uma ================= -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Pillars}" Margin="0,0,-14,18">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Plate Reveal="Rise" Stagger="True" Delay="60" Padding="0" Margin="0,0,14,0">
                            <Button Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Abrir"
                                    Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Background="Transparent">
                                            <Rectangle x:Name="Bar" Height="3" VerticalAlignment="Bottom" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}"/>
                                            <StackPanel Margin="18,14,16,16">
                                                <DockPanel>
                                                    <Path x:Name="Arrow" DockPanel.Dock="Right" Data="M0,4 H9 M6,1 L9,4 L6,7" Stroke="{StaticResource TextMuteBrush}"
                                                          StrokeThickness="1.4" VerticalAlignment="Center">
                                                        <Path.RenderTransform><TranslateTransform x:Name="ArrowTx" X="0"/></Path.RenderTransform>
                                                    </Path>
                                                    <Border Width="20" Height="20" Background="{StaticResource AccentBrush}" Margin="0,0,9,0">
                                                        <TextBlock Text="{Binding Letter}" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource AccentInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Big}" Style="{StaticResource Numeral}" FontSize="52" Margin="0,8,0,-6"
                                                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}"/>
                                                <TextBlock Text="{Binding Caption}" Style="{StaticResource Label}" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" FontSize="11.5" LineHeight="16" Margin="0,6,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                            </StackPanel>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ArrowTx" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="ArrowTx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Bar" Property="Height" Value="5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </ui:Plate>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================= LINHA 1: nota + osciloscópio ================= -->
            <Grid Grid.Row="2" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>

                <ui:Plate Reveal="Shutter" Magnetic="True" Code="P-01 / NOTA" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                        </Grid.ColumnDefinitions>
                        <!-- faixa de status vertical -->
                        <Border Grid.Column="1" Background="{Binding ScoreTone, Converter={StaticResource ToneBrush}}"/>
                        <StackPanel Margin="28,24,24,26">
                            <TextBlock Text="PRONTIDÃO PARA JOGO" Style="{StaticResource Label}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ScoreText}" Style="{StaticResource Numeral}" FontSize="164" Margin="-6,-28,0,-30"/>
                                    <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,8">
                                        <TextBlock Text="/100" Style="{StaticResource Label}" FontSize="13"/>
                                        <Rectangle Width="26" Height="3" Fill="{Binding ScoreTone, Converter={StaticResource ToneBrush}}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ScoreTitle, Converter={StaticResource Upper}}" Style="{StaticResource H2}" FontSize="32" TextWrapping="Wrap"
                                               Foreground="{Binding ScoreTone, Converter={StaticResource ToneBrush}}"/>
                                    <TextBlock Text="{Binding ScoreHint}" Style="{StaticResource Body}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Grid>
                            <ui:TickRuler Height="26" Margin="0,22,0,0" Ticks="80" Value="{Binding DisplayScore}" Tone="{Binding ScoreTone}"/>
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="100" Style="{StaticResource Label}"/>
                                <TextBlock Text="000" Style="{StaticResource Label}"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Content="OTIMIZAR AGORA" Style="{StaticResource BtnPrimary}" Command="{Binding OptimizeCommand}"/>
                                <Button Content="VER CHECK-UP COMPLETO" Style="{StaticResource Btn}" Command="{Binding CheckupCommand}" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ui:Plate>

                <ui:Plate Grid.Column="2" Reveal="Scan" Delay="120" Code="P-02 / OSCILOSCÓPIO">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center">
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.15" Duration="0:0:0.7"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                                <TextBlock Text="CPU · AO VIVO" Style="{StaticResource Label}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CpuNow}" Style="{StaticResource Numeral}" FontSize="68" Margin="-2,-4,0,-12"/>
                        </StackPanel>
                        <ui:PulseGraph Grid.Row="1" MinHeight="110" Margin="0,14,0,16" Stroke="{StaticResource AccentBrush}"
                                       Samples="{Binding CpuSamples}" Version="{Binding CpuVersion}"/>
                        <StackPanel Grid.Row="2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RamDetail}" Style="{StaticResource Label}"/>
                                <TextBlock Style="{StaticResource Label}">
                                    <Run Text="RAM"/>
                                    <Run Text="{Binding RamNow, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                </TextBlock>
                            </DockPanel>
                            <ui:TickRuler Height="12" Ticks="50" MajorEvery="0" Value="{Binding RamPct}" Tone="Info" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </ui:Plate>
            </Grid>

            <!-- ================= LINHA 2: ficha técnica ================= -->
            <ui:Plate Grid.Row="3" Reveal="Wipe" Delay="220" Code="P-03 / FICHA TÉCNICA" Padding="0" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource HatchMuteBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                        <TextBlock Text="FICHA TÉCNICA" Style="{StaticResource Numeral}" FontSize="20" Foreground="{StaticResource TextDimBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Specs}" Margin="0,4,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Plate Reveal="Rise" Stagger="True" Delay="380" ShowCorners="False" HoverFx="False"
                                          Background="Transparent" BorderBrush="Transparent" Padding="24,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" Margin="0,4,0,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource H3}" FontSize="17"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Rectangle Width="6" Height="6" Fill="{Binding Tone, Converter={StaticResource ToneBrush}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Label}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Rectangle Grid.ColumnSpan="2" Height="1" Fill="{StaticResource LineBrush}" VerticalAlignment="Bottom" Margin="0,0,0,-14"/>
                                    </Grid>
                                </ui:Plate>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ui:Plate>

            <!-- ================= LINHA 3: pendências + modo partida ================= -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>

                <ui:Plate Reveal="Rise" Delay="320" Code="P-04 / PENDÊNCIAS">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="VER TUDO →" Style="{StaticResource BtnLink}" Command="{Binding CheckupCommand}" VerticalAlignment="Center"/>
                            <TextBlock Text="O QUE CORRIGIR PRIMEIRO" Style="{StaticResource H2}"/>
                        </DockPanel>
                        <TextBlock Text="Nada pendente. Tudo o que o check-up mede está no lugar." Style="{StaticResource Body}" Margin="0,14,0,0"
                                   Visibility="{Binding NoIssues, Converter={StaticResource BoolVis}}"/>
                        <ItemsControl ItemsSource="{Binding Issues}" AlternationCount="100" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Plate Reveal="Rise" Stagger="True" Delay="450" ShowCorners="False" HoverFx="False"
                                              Background="Transparent" BorderBrush="Transparent" Padding="0">
                                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Numeral}" FontSize="40" Width="62" Margin="0,-6,0,0"
                                                           Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}"
                                                           Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter, AncestorLevel=2}, Converter={StaticResource Index}}"/>
                                                <Button DockPanel.Dock="Right" Content="{Binding ActionLabel, Converter={StaticResource Upper}}" Style="{StaticResource BtnGhost}"
                                                        VerticalAlignment="Center" Margin="14,0,0,0"
                                                        Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding HasAction, Converter={StaticResource BoolVis}}"/>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:Pill Text="{Binding StatusLabel}" Tone="{Binding Tone}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" Margin="0,0,0,6"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" FontSize="12.5" LineHeight="18"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </ui:Plate>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Plate>

                <ui:Plate Grid.Column="2" Reveal="Glitch" Delay="520" Code="P-05" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="56" Background="{StaticResource HatchAccentBrush}" Opacity="0.85"/>
                        <StackPanel Margin="24,20,24,24">
                            <TextBlock Text="MODO PARTIDA" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding SessionState}" FontSize="54" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Numeral}">
                                        <Setter Property="Foreground" Value="{StaticResource TextMuteBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SessionActive}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SessionInfo}" Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Margin="0,6,0,18"/>
                            <Button Content="{Binding SessionLabel}" Command="{Binding SessionCommand}" HorizontalAlignment="Left" Style="{StaticResource BtnPrimary}"/>
                        </StackPanel>
                    </DockPanel>
                </ui:Plate>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
