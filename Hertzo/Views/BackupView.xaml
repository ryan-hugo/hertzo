<UserControl x:Class="Hertzo.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Hertzo.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:PageHeader Number="09" Kicker="SEÇÃO 09 — BACKUP" Title="REDE DE SEGURANÇA"
                           Subtitle="Duas camadas: o ponto de restauração do Windows e o backup próprio do Hertzo, que guarda o valor original de cada configuração alterada."/>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ui:Plate Reveal="Shutter" Code="B-01">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="CRIAR AGORA" Style="{StaticResource BtnPrimary}" Command="{Binding RestorePointCommand}"/>
                            <Button Content="ABRIR" Style="{StaticResource BtnGhost}" Command="{Binding OpenRestoreCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CAMADA 1" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="PONTO DE RESTAURAÇÃO" Style="{StaticResource H2}" FontSize="26" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="Foto completa das configurações do Windows. Dá para voltar até pela tela de recuperação."
                                       Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Margin="0,8,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </ui:Plate>

                <ui:Plate Grid.Column="2" Reveal="Rise" Delay="140" Code="B-02" Magnetic="True">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="ABRIR PASTA" Style="{StaticResource BtnGhost}" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                        <StackPanel>
                            <TextBlock Text="CAMADA 2" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding Pending}" Style="{StaticResource Numeral}" FontSize="84" Margin="-3,-10,0,-14"/>
                            <TextBlock Text="{Binding PendingLabel, Converter={StaticResource Upper}}" Style="{StaticResource Label}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </ui:Plate>

                <ui:Plate Grid.Column="4" Reveal="Glitch" Delay="280" Code="B-03" Padding="0" BorderBrush="#55F0473E">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="16" Background="{StaticResource HatchBadBrush}"/>
                        <DockPanel Margin="24,18,24,22">
                            <Button DockPanel.Dock="Bottom" Content="DESFAZER TUDO" Style="{StaticResource BtnDanger}" Command="{Binding UndoAllCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                            <StackPanel>
                                <TextBlock Text="BOTÃO DE PÂNICO" Style="{StaticResource Label}" Foreground="{StaticResource BadBrush}"/>
                                <TextBlock Text="VOLTAR AO ORIGINAL" Style="{StaticResource H2}" FontSize="26" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="Cada configuração volta ao valor exato de antes do Hertzo, mesmo depois de reiniciar."
                                           Style="{StaticResource Body}" FontSize="12.5" LineHeight="18" Margin="0,8,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </DockPanel>
                </ui:Plate>
            </Grid>

            <!-- Linha do tempo -->
            <ui:Plate Grid.Row="2" Reveal="Scan" Delay="200" Code="B-04 / LOG">
                <StackPanel>
                    <TextBlock Text="REGISTRO DE ALTERAÇÕES" Style="{StaticResource H2}" Margin="0,0,0,14"/>
                    <TextBlock Text="Nenhuma alteração ainda." Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid>
                        <Rectangle Width="1" HorizontalAlignment="Left" Margin="110,0,0,0" Fill="{StaticResource LineStrongBrush}"/>
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2" MinHeight="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="13"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                        <Rectangle x:Name="Dot" Grid.Column="1" Width="9" Height="9" Fill="{StaticResource TextMuteBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" Style="{StaticResource Body}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="apply"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="revert"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource InfoBrush}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="clean"><Setter TargetName="Dot" Property="Fill" Value="{StaticResource WarnBrush}"/></DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </ui:Plate>
        </Grid>
    </ScrollViewer>
</UserControl>
