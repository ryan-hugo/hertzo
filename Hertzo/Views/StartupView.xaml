<UserControl x:Class="Hertzo.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Hertzo.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Style="{StaticResource PageGrid}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:PageHeader Number="08" Kicker="SEÇÃO 08 — INICIALIZAÇÃO" Title="ABREM COM O WINDOWS"
                           Subtitle="Mesmo mecanismo do Gerenciador de Tarefas: nada é apagado, só deixa de abrir sozinho. Anti-cheat, segurança e áudio ficam marcados.">
                <Button Content="ATUALIZAR LISTA" Style="{StaticResource Btn}" Command="{Binding RefreshCommand}"/>
            </ui:PageHeader>

            <ui:Plate Grid.Row="1" Reveal="Wipe" Padding="0">
                <StackPanel>
                    <Border Background="{StaticResource Bg2Brush}" Padding="24,12" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="1" Text="PROGRAMA" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="2" Text="ORIGEM / COMANDO" Style="{StaticResource Label}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Summary, Converter={StaticResource Upper}}" Style="{StaticResource Label}" HorizontalAlignment="Right" Visibility="Collapsed"/>
                            <TextBlock Grid.Column="3" Text="ESTADO" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Items}" AlternationCount="1000">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Plate Reveal="Rise" Stagger="True" Delay="200" ShowCorners="False" HoverFx="False" Background="Transparent" BorderBrush="Transparent" Padding="0">
                                    <Border x:Name="RowBd" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,13" Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource Numeral}" FontSize="22" Foreground="{StaticResource TextMuteBrush}" VerticalAlignment="Center"
                                                       Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter, AncestorLevel=2}, Converter={StaticResource Index}}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="260"/>
                                                    <Border Background="{StaticResource InfoBrush}" Padding="5,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding KeepOn, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="MANTER" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentInkBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Label}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Source, Converter={StaticResource Upper}}" Style="{StaticResource Label}" Foreground="{StaticResource TextDimBrush}"/>
                                                <TextBlock Text="{Binding Command}" Style="{StaticResource Label}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Command}"/>
                                            </StackPanel>
                                            <ToggleButton Grid.Column="3" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                                          IsChecked="{Binding Enabled, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </ui:Plate>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="RowBd" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Bg2Brush}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Summary, Converter={StaticResource Upper}}" Style="{StaticResource Label}" Margin="24,16,24,20"/>
                </StackPanel>
            </ui:Plate>
        </Grid>
    </ScrollViewer>
</UserControl>
