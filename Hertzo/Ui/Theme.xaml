<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Hertzo.Ui"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        HERTZO — “ficha de telemetria”
        Referências: Estilo Tipográfico Internacional (grade modular assimétrica, tipo gigante, fios finos),
        design industrial de instrumentos (Braun/Dieter Rams, sintetizadores): uma cor de sinal, rótulos minúsculos,
        controles que parecem físicos; e o “tátil” de 2026: grão de filme, hachuras e marcas de corte de gráfica.
        Tipografia: Bahnschrift (DIN, tipo de sinalização industrial, nativo do Windows) + Cascadia Mono.
    -->

    <ui:BoolVisConverter x:Key="BoolVis"/>
    <ui:NullVisConverter x:Key="NullVis"/>
    <ui:ToneBrushConverter x:Key="ToneBrush"/>
    <ui:UpperConverter x:Key="Upper"/>
    <ui:IndexConverter x:Key="Index"/>

    <!-- ============ CORES ============ -->
    <Color x:Key="Bg0">#0D0C0A</Color>
    <Color x:Key="Bg1">#141310</Color>
    <Color x:Key="Bg2">#1A1915</Color>
    <Color x:Key="Bg3">#23211C</Color>
    <Color x:Key="Bg4">#33302A</Color>
    <Color x:Key="Line">#2A2822</Color>
    <Color x:Key="LineStrong">#4A463D</Color>
    <Color x:Key="Text">#EDE6D6</Color>
    <Color x:Key="TextDim">#A8A193</Color>
    <Color x:Key="TextMute">#6E695E</Color>
    <Color x:Key="Accent">#FF5B1F</Color>
    <Color x:Key="AccentHover">#FF7A47</Color>
    <Color x:Key="AccentInk">#0D0C0A</Color>
    <Color x:Key="Ok">#A9C98A</Color>
    <Color x:Key="Warn">#F2C14E</Color>
    <Color x:Key="Bad">#F0473E</Color>
    <Color x:Key="Info">#8DB6C7</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}"/>
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}"/>
    <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrong}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}"/>
    <SolidColorBrush x:Key="TextMuteBrush" Color="{StaticResource TextMute}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInk}"/>
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource Ok}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource Warn}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource Bad}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1FFF5B1F"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="#17A9C98A"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#17F2C14E"/>
    <SolidColorBrush x:Key="BadSoftBrush" Color="#1CF0473E"/>
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#178DB6C7"/>
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#10EDE6D6"/>
    <SolidColorBrush x:Key="ScrimBrush" Color="#D90D0C0A"/>

    <!-- Hachuras (sombra dura, estados “desligado”, faixas decorativas) -->
    <DrawingBrush x:Key="HatchAccentBrush" TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,7 L7,0 M-1,1 L1,-1 M6,8 L8,6">
                <GeometryDrawing.Pen><Pen Thickness="1.3" Brush="{StaticResource AccentBrush}"/></GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="HatchMuteBrush" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,6 L6,0 M-1,1 L1,-1 M5,7 L7,5">
                <GeometryDrawing.Pen><Pen Thickness="1" Brush="#3A362F"/></GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="HatchBadBrush" TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M0,7 L7,0 M-1,1 L1,-1 M6,8 L8,6">
                <GeometryDrawing.Pen><Pen Thickness="1.2" Brush="#66F0473E"/></GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Linha pontilhada de recibo -->
    <DrawingBrush x:Key="DotsBrush" TileMode="Tile" Viewport="0,0,4,1" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H4 V1 H0 Z"/>
                <GeometryDrawing Brush="{StaticResource LineStrongBrush}" Geometry="M0,0 H1 V1 H0 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Feixe de varredura -->
    <LinearGradientBrush x:Key="SweepBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FF5B1F" Offset="0"/>
        <GradientStop Color="#33FF5B1F" Offset="0.75"/>
        <GradientStop Color="#CCFF7A47" Offset="0.97"/>
        <GradientStop Color="#00FF5B1F" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ TIPOGRAFIA ============ -->
    <FontFamily x:Key="FontUi">Bahnschrift</FontFamily>
    <FontFamily x:Key="FontDisplay">Bahnschrift</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>

    <!-- Título de página: condensado, caixa-alta, gigante -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontStretch" Value="Condensed"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="54"/>
        <Setter Property="LineHeight" Value="52"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontStretch" Value="Condensed"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuteBrush}"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <!-- Numeral grande (dados) -->
    <Style x:Key="Numeral" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontStretch" Value="Condensed"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- ============ PLACA ============ -->
    <Style TargetType="ui:Plate">
        <Setter Property="Padding" Value="24,22"/>
        <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Plate">
                    <Grid>
                        <Border x:Name="PART_Shadow" Background="{StaticResource HatchAccentBrush}" Opacity="0"/>
                        <Border x:Name="PART_Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" ClipToBounds="True" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter x:Name="PART_Content" Margin="{TemplateBinding Padding}"/>
                                <Rectangle x:Name="PART_Sweep" Width="140" HorizontalAlignment="Left" IsHitTestVisible="False"
                                           Opacity="0" Fill="{StaticResource SweepBrush}"/>
                                <Rectangle x:Name="PART_Scan" Height="2" VerticalAlignment="Top" IsHitTestVisible="False"
                                           Opacity="0" Fill="{StaticResource AccentBrush}"/>
                                <TextBlock Text="{TemplateBinding Code}" FontFamily="{StaticResource FontMono}" FontSize="9.5"
                                           Foreground="{StaticResource TextMuteBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Margin="0,9,12,0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <!-- marcas de corte -->
                        <Grid Margin="-5" IsHitTestVisible="False"
                              Visibility="{Binding ShowCorners, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVis}}">
                            <Path x:Name="PART_TL" Data="M0,9 V0 H9" Stroke="{StaticResource TextMuteBrush}" StrokeThickness="1.2" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Path x:Name="PART_TR" Data="M0,0 H9 V9" Stroke="{StaticResource TextMuteBrush}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                            <Path x:Name="PART_BL" Data="M0,0 V9 H9" Stroke="{StaticResource TextMuteBrush}" StrokeThickness="1.2" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                            <Path x:Name="PART_BR" Data="M9,0 V9 H0" Stroke="{StaticResource TextMuteBrush}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Placa “linha” (listas): padding menor, sem marcas grandes -->
    <Style x:Key="Row" TargetType="ui:Plate" BasedOn="{StaticResource {x:Type ui:Plate}}">
        <Setter Property="Padding" Value="22,18"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="Stagger" Value="True"/>
    </Style>

    <!-- ============ BOTÕES ============ -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontStretch" Value="SemiCondensed"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" Background="{StaticResource TextBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                        </Border>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value><TranslateTransform X="1" Y="1"/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primário: bloco laranja com seta que avança no hover e sombra dura -->
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow" Background="{StaticResource HatchAccentBrush}" Opacity="0">
                            <Border.RenderTransform><TranslateTransform X="0" Y="0"/></Border.RenderTransform>
                        </Border>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Border.RenderTransform><TranslateTransform X="0" Y="0"/></Border.RenderTransform>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path x:Name="Arrow" Data="M0,5 H11 M7,1 L11,5 L7,9" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                      VerticalAlignment="Center" Margin="12,1,0,0">
                                    <Path.RenderTransform><TranslateTransform X="0"/></Path.RenderTransform>
                                </Path>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="5" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="-3" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="Background" Value="{StaticResource BadBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BadBrush}"/>
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="BtnLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent">
                        <ContentPresenter/>
                        <Rectangle x:Name="U" Height="1" Fill="{TemplateBinding Foreground}" Margin="0,2,0,0" RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform><ScaleTransform ScaleX="0.25"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="U" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="U" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.25" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionBtn" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Bg3Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ FICHA DE ESCOLHA (alvo / duração) ============ -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="12,9,14,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Shadow" Background="{StaticResource HatchAccentBrush}" Opacity="0" Margin="3,3,-3,-3"/>
                        <Border x:Name="Bd" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Fill" Background="{StaticResource TextBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.28">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Marcador pequeno (A / B da comparação). Tag=True = marcado -->
    <Style x:Key="MarkBtn" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" BorderThickness="1" BorderBrush="{StaticResource LineStrongBrush}" Background="Transparent" SnapsToDevicePixels="True">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag">
                            <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="T" Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ FADER (volume) ============ -->
    <Style x:Key="FaderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Rectangle Height="3" VerticalAlignment="Center" Fill="{TemplateBinding Background}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Fader" TargetType="Slider">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <!-- marcas de régua sob o trilho -->
                        <Rectangle Height="7" VerticalAlignment="Bottom" Fill="{StaticResource HatchMuteBrush}" Opacity="0.5"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource FaderRepeat}" Background="{StaticResource AccentBrush}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource FaderRepeat}" Background="{StaticResource Bg4Brush}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="K" Width="12" Height="20" Background="{StaticResource TextBrush}" BorderBrush="{StaticResource Bg0Brush}" BorderThickness="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="K" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="K" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tecla física (atalho) -->
    <Style x:Key="KeyCap" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1,1,1,4"/>
        <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
        <Setter Property="Padding" Value="12,6,12,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ============ CHAVE BASCULANTE OFF | ON ============ -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="70"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" BorderThickness="1" BorderBrush="{StaticResource LineStrongBrush}" Background="{StaticResource HatchMuteBrush}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="OFF" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource TextMuteBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ON" FontFamily="{StaticResource FontMono}" FontSize="9" Foreground="{StaticResource TextMuteBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Knob" Grid.ColumnSpan="2" Width="32" Margin="2" HorizontalAlignment="Left" Background="{StaticResource Bg4Brush}">
                                <Border.RenderTransform><TranslateTransform x:Name="Tx" X="0"/></Border.RenderTransform>
                                <Grid>
                                    <TextBlock x:Name="KnobOff" Text="OFF" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="KnobOn" Text="ON" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource TextDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tx" Storyboard.TargetProperty="X" To="34" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="KnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26">
                                            <DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetName="KnobOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Knob" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource Bg2Brush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ CHECKBOX QUADRADA ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" BorderThickness="1"
                                BorderBrush="{StaticResource LineStrongBrush}" Background="{StaticResource Bg2Brush}" VerticalAlignment="Center">
                            <Rectangle x:Name="Mark" Width="8" Height="8" Fill="{StaticResource AccentInkBrush}" RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform><ScaleTransform ScaleX="0" ScaleY="0"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase Amplitude="1"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><BackEase Amplitude="1"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ NAVEGAÇÃO ============ -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Height="40" Background="Transparent">
                        <Border x:Name="Fill" Background="{StaticResource AccentBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                        </Border>
                        <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource LineBrush}"/>
                        <DockPanel Margin="14,0,12,0">
                            <TextBlock x:Name="Num" DockPanel.Dock="Left" Text="{Binding Number}" Style="{StaticResource Numeral}" FontSize="20"
                                       Foreground="{StaticResource TextMuteBrush}" Width="40" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" MinWidth="20" Height="18" Padding="5,0" Background="{StaticResource WarnBrush}"
                                    VerticalAlignment="Center" Visibility="{Binding HasBadge, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource AccentInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Path x:Name="Arrow" DockPanel.Dock="Right" Data="M0,4 H9 M6,1 L9,4 L6,7" Stroke="{StaticResource TextBrush}" StrokeThickness="1.4"
                                  VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0">
                                <Path.RenderTransform><TranslateTransform x:Name="ArrowTx" X="-6"/></Path.RenderTransform>
                            </Path>
                            <TextBlock x:Name="Txt" Text="{Binding Title, Converter={StaticResource Upper}}" FontFamily="{StaticResource FontUi}"
                                       FontStretch="SemiCondensed" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ArrowTx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="ArrowTx" Storyboard.TargetProperty="X" To="-6" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.32">
                                            <DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
                            <Setter TargetName="Num" Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentInkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ SCROLLBAR ============ -->
    <Style x:Key="ThumbSlim" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="{StaticResource Bg4Brush}" Margin="4,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="11"/>
        <Setter Property="MinWidth" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Rectangle Width="1" Fill="{StaticResource LineBrush}" HorizontalAlignment="Center"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb><Thumb Style="{StaticResource ThumbSlim}"/></Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb><Thumb Style="{StaticResource ThumbSlim}"/></Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource TextBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="9,5"/>
    </Style>

    <!-- Indicador de carregamento -->
    <Style x:Key="BusyTick" TargetType="Rectangle">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
        <Setter Property="RenderTransform">
            <Setter.Value><ScaleTransform ScaleY="0.25"/></Setter.Value>
        </Setter>
    </Style>

    <!-- Cabeçalho de página: numeral contornado gigante sobreposto ao título, régua que varre -->
    <Style TargetType="ui:PageHeader">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:PageHeader">
                    <Grid Margin="0,0,0,30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ui:OutlineText Text="{TemplateBinding Number}" Size="190" Stroke="{StaticResource LineStrongBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,0,0,0"/>
                        <DockPanel Margin="74,62,0,0" LastChildFill="True">
                            <ContentPresenter DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="24,0,0,4"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="18" Height="2" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{TemplateBinding Kicker}" Style="{StaticResource Label}" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource H1}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="{TemplateBinding Subtitle}" Style="{StaticResource Body}" Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </DockPanel>
                        <ui:TickRuler Grid.Row="1" Height="8" Ticks="140" MajorEvery="10" Value="100" Tone="Neutral" Margin="0,22,0,0" Opacity="0.35"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageGrid" TargetType="Grid">
        <Setter Property="Margin" Value="40,0,40,44"/>
    </Style>

</ResourceDictionary>
